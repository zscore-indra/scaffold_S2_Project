# External FX rate provider (Frankfurter: ECB data, no key required).
FX_API_URL=https://api.frankfurter.dev/v1/latest
# Frankfurter needs no key; set this only if you swap in a keyed provider.
FX_API_KEY=

# Database (defaults to sqlite:///expenseflow.db when unset).
DATABASE_URL=sqlite:///expenseflow.db

# Anthropic API key for LLM-generated spending insights (app/insights.py).
#ANTHROPIC_API_KEY=
